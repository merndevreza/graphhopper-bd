{
  // Bangladesh-tuned motorcycle model. Unlike the built-in motorcycle.json it
  // does NOT penalize motorways/trunks - in Bangladesh motorcycles legally use
  // national highways and flyovers, and avoiding them inflates billing
  // distances by ~25%. Keeps: no private roads, no rough tracks, slow speed
  // on bad surfaces.
  "distance_influence": 90,
  "priority": [
    { "if": "!car_access", "multiply_by": "0" },
    { "if": "track_type.ordinal() > 1", "multiply_by": "0" },
    { "if": "road_access == PRIVATE", "multiply_by": "0" },
    { "if": "road_access == DESTINATION", "multiply_by": "0.1" }
  ],
  "speed": [
    { "if": "true", "limit_to": "0.9 * car_average_speed" },
    { "if": "true", "limit_to": "80" },
    { "if": "surface==COBBLESTONE || surface==GRASS || surface==GRAVEL || surface==SAND || surface==PAVING_STONES || surface==DIRT || surface==GROUND || surface==UNPAVED || surface==COMPACTED",
      "limit_to": "30"
    }
  ]
}
